# Optional standalone DataHarmonizer bundle builder.
#
# Build:
#   docker build -f Dockerfile.dh-builder \
#     --build-context dataharmonizer-src=../DataHarmonizer \
#     -t dh-template-builder-dh-builder .
#
# Run:
#   docker run --rm -v "$PWD/schema:/schema:ro" -v "$PWD/out:/output" \
#     dh-template-builder-dh-builder
#
# Expects /schema/schema.yaml and writes a DataHarmonizer web bundle to /output.
FROM node:20-slim

RUN apt-get update && apt-get install -y python3 python3-pip && rm -rf /var/lib/apt/lists/*

COPY --from=dataharmonizer-src . /dh-src
RUN pip install --no-cache-dir --break-system-packages -r /dh-src/requirements.txt
RUN cd /dh-src && yarn install --frozen-lockfile

COPY scripts/dh_builder/dh_build_steps.sh /opt/dh_build_steps.sh
COPY scripts/dh_builder/entrypoint.sh /opt/entrypoint.sh
RUN chmod +x /opt/entrypoint.sh /opt/dh_build_steps.sh

ENTRYPOINT ["/opt/entrypoint.sh"]
